DLGTEMPLATE IDD_BROWSE
BEGIN
    DIALOG "Browse", IDD_BROWSE, 20, 20, 360, 220, , FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        LTEXT "Directory:", -1, 8, 202, 60, 8
        LTEXT "", IDC_BROWSEPATH, 70, 202, 282, 8

        /* CCS_MINIRECORDCORE makes records MINIRECORDCORE rather than
           RECORDCORE - the struct the code allocates must match this style
           [os2ref/pm-controls.md 15]. */
        CONTROL "", IDC_BROWSECNR, 8, 40, 344, 156, WC_CONTAINER,
                CCS_MINIRECORDCORE | CCS_SINGLESEL | CCS_AUTOPOSITION |
                WS_VISIBLE | WS_TABSTOP | WS_GROUP

        DEFPUSHBUTTON "~Open",   DID_OK,     232, 14, 56, 14
        PUSHBUTTON    "Cancel",  DID_CANCEL, 296, 14, 56, 14
    END
END

