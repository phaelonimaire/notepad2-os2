#include <os2.h>
#include "np2.h"

MENU IDD_NP2MAIN
BEGIN
    SUBMENU "~File", IDM_FILE
    BEGIN
        MENUITEM "~New\tCtrl+N",     IDM_NEW
        MENUITEM "~Open...\tCtrl+O", IDM_OPEN
        MENUITEM "~Save\tCtrl+S",    IDM_SAVE
        MENUITEM "Save ~as...",      IDM_SAVEAS
        MENUITEM "Re~vert",          IDM_REVERT
        MENUITEM "Recent F~iles...", IDM_RECENT
        MENUITEM "Bro~wse...",       IDM_BROWSE
        MENUITEM SEPARATOR
        MENUITEM "~Print...",        IDM_PRINT
        MENUITEM "Page Set~up...",   IDM_PAGESETUP
        MENUITEM SEPARATOR
        MENUITEM "~Read Only",       IDM_READONLY
        SUBMENU "~Encoding", IDM_ENC_MENU
        BEGIN
            MENUITEM "~ANSI",                  IDM_ENC_ANSI
            MENUITEM "~OEM (850)",             IDM_ENC_OEM
            MENUITEM "UTF-~8",                 IDM_ENC_UTF8
            MENUITEM "UTF-8 with ~Signature",  IDM_ENC_UTF8SIG
            MENUITEM "~Unicode (UCS-2 LE)",    IDM_ENC_UCS2LE
            MENUITEM "Unicode ~Big Endian",    IDM_ENC_UCS2BE
        END
        SUBMENU "Reloa~d As", IDM_RELOAD_MENU
        BEGIN
            MENUITEM "~ANSI",  IDM_RELOAD_ANSI
            MENUITEM "~OEM",   IDM_RELOAD_OEM
            MENUITEM "UTF-~8", IDM_RELOAD_UTF8
        END
        SUBMENU "~Launch", IDM_LAUNCH_MENU
        BEGIN
            MENUITEM "~New Window",       IDM_NEWWINDOW
            MENUITEM "~Empty Window",     IDM_EMPTYWINDOW
            MENUITEM "E~xecute Document", IDM_EXECDOC
            MENUITEM "~Command...",       IDM_RUNCMD
        END
        SUBMENU "Line Endin~gs", IDM_EOL_MENU
        BEGIN
            MENUITEM "~Windows (CR+LF)", IDM_EOL_CRLF
            MENUITEM "~Unix (LF)",       IDM_EOL_LF
            MENUITEM "~Mac (CR)",        IDM_EOL_CR
        END
        MENUITEM SEPARATOR
        MENUITEM "E~xit", IDM_EXIT
    END
    SUBMENU "~Edit", IDM_EDIT
    BEGIN
        MENUITEM "~Undo\tCtrl+Z",   IDM_UNDO
        MENUITEM "~Redo\tCtrl+Y",   IDM_REDO
        MENUITEM SEPARATOR
        MENUITEM "Cu~t\tCtrl+X",    IDM_CUT
        MENUITEM "Cop~y\tCtrl+C",   IDM_COPY
        MENUITEM "Copy A~ll",        IDM_COPYALL
        MENUITEM "Copy Ad~d",        IDM_COPYADD
        MENUITEM "~Paste\tCtrl+V",  IDM_PASTE
        MENUITEM "Cle~ar",           IDM_CLEAR
        MENUITEM "Clear Clip~board", IDM_CLEARCLIPBOARD
        MENUITEM SEPARATOR
        MENUITEM "~Select All\tCtrl+A", IDM_SELECTALL
        MENUITEM SEPARATOR
        SUBMENU "L~ines", IDM_LINES
        BEGIN
            MENUITEM "Move ~Up\tCtrl+Shift+Up",     IDM_MOVELINEUP
            MENUITEM "Move ~Down\tCtrl+Shift+Down", IDM_MOVELINEDOWN
            MENUITEM "Duplicate ~Line\tCtrl+D",     IDM_DUPLICATELINE
            MENUITEM "~Cut Line\tCtrl+L",           IDM_CUTLINE
            MENUITEM "C~opy Line",                   IDM_COPYLINE
            MENUITEM "D~elete Line\tCtrl+Shift+L",  IDM_DELETELINE
            MENUITEM SEPARATOR
            MENUITEM "~Split Lines",       IDM_SPLITLINES
            MENUITEM "~Join Lines",        IDM_JOINLINES
            MENUITEM "Join ~Paragraphs",   IDM_JOINPARAGRAPHS
            MENUITEM SEPARATOR
            MENUITEM "~Modify Lines...",   IDM_MODIFYLINES
            MENUITEM "~Align Lines...",    IDM_ALIGNLINES
            MENUITEM "So~rt Lines...",     IDM_SORTLINES
        END
        SUBMENU "Bloc~k", IDM_BLOCK
        BEGIN
            MENUITEM "~Indent\tTab",             IDM_INDENT
            MENUITEM "~Unindent\tShift+Tab",     IDM_UNINDENT
            MENUITEM "~Duplicate Selection",      IDM_SELDUPLICATE
            MENUITEM "~Pad With Spaces",          IDM_PADWITHSPACES
            MENUITEM SEPARATOR
            MENUITEM "Strip ~First Character",    IDM_STRIP1STCHAR
            MENUITEM "Strip ~Last Character",     IDM_STRIPLASTCHAR
            MENUITEM "Strip ~Trailing Blanks",    IDM_TRIMLINES
            MENUITEM "Compress ~Whitespace",      IDM_COMPRESSWS
            MENUITEM SEPARATOR
            MENUITEM "~Merge Blank Lines",        IDM_MERGEBLANKLINES
            MENUITEM "~Remove Blank Lines",       IDM_REMOVEBLANKLINES
        END
        SUBMENU "~Enclose Selection", IDM_ENCLOSEMENU
        BEGIN
            MENUITEM "~With...",         IDM_ENCLOSESEL
            MENUITEM SEPARATOR
            MENUITEM "~( )",             IDM_ENCLOSE_PAREN
            MENUITEM "~{ }",             IDM_ENCLOSE_BRACE
            MENUITEM "~[ ]",             IDM_ENCLOSE_BRACKET
            MENUITEM "~Single Quotes",   IDM_ENCLOSE_SQUOTE
            MENUITEM "~Double Quotes",   IDM_ENCLOSE_DQUOTE
            MENUITEM "~Backticks",       IDM_ENCLOSE_BACKTICK
        END
        SUBMENU "C~onvert", IDM_CONVERT
        BEGIN
            MENUITEM "~Uppercase\tCtrl+U",     IDM_UPPERCASE
            MENUITEM "~Lowercase\tCtrl+Shift+U", IDM_LOWERCASE
            MENUITEM "~Invert Case",            IDM_INVERTCASE
            MENUITEM "Title ~Case",             IDM_TITLECASE
            MENUITEM "~Sentence Case",          IDM_SENTENCECASE
            MENUITEM SEPARATOR
            MENUITEM "~Tabify Selection",       IDM_TABIFYSEL
            MENUITEM "U~ntabify Selection",     IDM_UNTABIFYSEL
            MENUITEM "Ta~bify Indent",          IDM_TABIFYINDENT
            MENUITEM "Untabi~fy Indent",        IDM_UNTABIFYINDENT
        END
        SUBMENU "I~nsert", IDM_INSERTMENU
        BEGIN
            MENUITEM "HTML/~XML Tag...",        IDM_INSERTTAG
            MENUITEM SEPARATOR
            MENUITEM "Time/Date (~Short Form)", IDM_INSERT_TIMESHORT
            MENUITEM "Time/Date (~Long Form)",  IDM_INSERT_TIMELONG
            MENUITEM "~Filename",               IDM_INSERT_FILENAME
            MENUITEM "~Path and Filename",      IDM_INSERT_PATHNAME
        END
        SUBMENU "Spe~cial", IDM_SPECIAL
        BEGIN
            MENUITEM "Line Comment (~Toggle)\tCtrl+Q", IDM_LINECOMMENT
            MENUITEM "Stream C~omment",          IDM_STREAMCOMMENT
            MENUITEM SEPARATOR
            MENUITEM "URL ~Encode",              IDM_URLENCODE
            MENUITEM "URL ~Decode",              IDM_URLDECODE
            MENUITEM "Esca~pe C Chars",          IDM_ESCAPECCHARS
            MENUITEM "~Unescape C Chars",        IDM_UNESCAPECCHARS
            MENUITEM "C~har To Hex",             IDM_CHAR2HEX
            MENUITEM "He~x To Char",             IDM_HEX2CHAR
            MENUITEM SEPARATOR
            MENUITEM "~Find Matching Brace\tCtrl+B",       IDM_FINDMATCHBRACE
            MENUITEM "Se~lect To Matching Brace\tCtrl+Shift+B", IDM_SELTOMATCHBRACE
            MENUITEM SEPARATOR
            MENUITEM "Delete L~ine Left",        IDM_DELLINELEFT
            MENUITEM "Delete Line Ri~ght",       IDM_DELLINERIGHT
            MENUITEM "Delete ~Word Left\tCtrl+Backspace",  IDM_DELWORDLEFT
            MENUITEM "Delete Word ~Right\tCtrl+Delete",    IDM_DELWORDRIGHT
        END
        SUBMENU "Book~marks", IDM_BOOKMARKS
        BEGIN
            MENUITEM "~Toggle\tCtrl+F2",        IDM_BOOKMARKTOGGLE
            MENUITEM "Goto ~Next\tF2",          IDM_BOOKMARKNEXT
            MENUITEM "Goto ~Previous\tShift+F2", IDM_BOOKMARKPREV
            MENUITEM "~Clear All",               IDM_BOOKMARKCLEAR
        END
    END
    SUBMENU "~Search", IDM_SEARCH
    BEGIN
        MENUITEM "~Find...\tCtrl+F",     IDM_FIND
        MENUITEM "Find ~Next\tF3",       IDM_FINDNEXT
        MENUITEM "Find ~Previous\tShift+F3", IDM_FINDPREV
        MENUITEM "~Replace...\tCtrl+H",  IDM_REPLACE
        MENUITEM SEPARATOR
        MENUITEM "~Go To Line...\tCtrl+G", IDM_GOTOLINE
    END
    SUBMENU "~View", IDM_VIEW
    BEGIN
        /* The Syntax Scheme submenu is filled at run time from np2style.c's
           table - an empty placeholder here keeps the two from drifting. */
        SUBMENU "S~yntax Scheme", IDM_SCHEME_MENU
        BEGIN
            MENUITEM "(none)", IDM_SCHEME_BASE
        END
        MENUITEM "Default ~Font...",       IDM_VIEW_FONT
        MENUITEM "Customi~ze Colours...",  IDM_SCHEMECONFIG
        MENUITEM SEPARATOR
        MENUITEM "~Word Wrap",             IDM_WORDWRAP
        MENUITEM "~Long Line Marker",      IDM_LONGLINEMARKER
        MENUITEM "Indentation ~Guides",    IDM_INDENTGUIDES
        MENUITEM "Show W~hitespace",       IDM_SHOWWHITESPACE
        MENUITEM "Show Line ~Endings",     IDM_SHOWEOLS
        MENUITEM "Highlight C~urrent Line", IDM_HILITECURLINE
        SUBMENU "Mar~k Occurrences", IDM_MARKOCC_MENU
        BEGIN
            MENUITEM "~Off",                    IDM_MARKOCC_OFF
            MENUITEM "~Red",                    IDM_MARKOCC_RED
            MENUITEM "~Green",                  IDM_MARKOCC_GREEN
            MENUITEM "~Blue",                   IDM_MARKOCC_BLUE
            MENUITEM SEPARATOR
            MENUITEM "Match ~Case",             IDM_MARKOCC_CASE
            MENUITEM "Match ~Whole Words Only", IDM_MARKOCC_WORD
        END
        MENUITEM SEPARATOR
        MENUITEM "Show Status~bar",        IDM_STATUSBAR
        MENUITEM "Line ~Numbers",          IDM_LINENUMBERS
        MENUITEM "Selection ~Margin",      IDM_SELMARGIN
        MENUITEM "~Code Folding",          IDM_FOLDING
        MENUITEM "~Toggle All Folds",      IDM_TOGGLEFOLDS
        MENUITEM SEPARATOR
        MENUITEM "Zoom ~In\tCtrl+Plus",   IDM_ZOOMIN
        MENUITEM "Zoom ~Out\tCtrl+Minus", IDM_ZOOMOUT
        MENUITEM "~Reset Zoom",            IDM_RESETZOOM
    END
    SUBMENU "Se~ttings", IDM_SETTINGS
    BEGIN
        MENUITEM "Insert Tabs as ~Spaces", IDM_TABSASSPACES
        MENUITEM "Auto ~Indent Text",      IDM_AUTOINDENT
        MENUITEM SEPARATOR
        MENUITEM "~Tab Settings...",       IDM_TABSETTINGS
        MENUITEM "~Long Line Settings...", IDM_LONGLINESET
        MENUITEM "~Word Wrap Settings...", IDM_WORDWRAPSET
    END
    SUBMENU "~Help", IDM_HELP
    BEGIN
        MENUITEM "~About Notepad2...", IDM_ABOUT
    END
END

/* ==========================================================================
 * Dialogs.
 *
 * All laid out from scratch rather than by converting the Win32 coordinates:
 * PM dialog units have a BOTTOM-LEFT origin, so a mechanical translation of the
 * original y values produces an upside-down dialog that still compiles and still
 * loads [os2ref/resources-and-dialogs.md 2.1].
 *
 * Two rules applied throughout, both learned the hard way on the Find dialog:
 *
 *  - No "~" in an LTEXT. A PM static control has no mnemonic and draws the tilde
 *    literally; only buttons, checkboxes and menu items honour it
 *    [DOC-IBM pm3.txt "Static Control Styles"].
 *  - Combo boxes are CONTROL + WC_COMBOBOX, never the COMBOBOX shorthand, which
 *    wrc accepts and PM then rejects with PMERR_INVALID_HWND. A combo's cy spans
 *    the entry field PLUS the dropped-down list, so the entry field renders at the
 *    TOP of the stated rectangle and each combo sits well below its label.
 * ========================================================================== */

DLGTEMPLATE IDD_GOTOLINE
BEGIN
    DIALOG "Go To Line", IDD_GOTOLINE, 20, 20, 200, 64, , FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        LTEXT         "Line:",    -1,           8, 46, 40, 8
        ENTRYFIELD    "", IDC_LINENUM,          8, 30, 50, 10, ES_MARGIN | ES_AUTOSCROLL
        LTEXT         "Column:",  -1,          70, 46, 45, 8
        ENTRYFIELD    "", IDC_COLNUM,          70, 30, 50, 10, ES_MARGIN | ES_AUTOSCROLL
        DEFPUSHBUTTON "OK",     DID_OK,        138, 42, 54, 14
        PUSHBUTTON    "Cancel", DID_CANCEL,    138, 22, 54, 14
    END
END

DLGTEMPLATE IDD_TABSETTINGS
BEGIN
    DIALOG "Tab Settings", IDD_TABSETTINGS, 20, 20, 252, 114, , FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        LTEXT      "Tabulator width:",  -1,            8, 92, 72, 8
        ENTRYFIELD "", IDC_TABWIDTH,                  86, 90, 36, 10, ES_MARGIN | ES_AUTOSCROLL
        LTEXT      "Indentation size:", -1,            8, 76, 72, 8
        ENTRYFIELD "", IDC_INDENTWIDTH,               86, 74, 36, 10, ES_MARGIN | ES_AUTOSCROLL

        AUTOCHECKBOX "Insert tabs as ~spaces.",                 IDC_TABSASSPACES, 8, 56, 175, 10
        AUTOCHECKBOX "Tab ~key reformats indentation.",         IDC_TABINDENTS,   8, 42, 175, 10
        AUTOCHECKBOX "~Backspace key reformats indentation.",   IDC_BSUNINDENTS,  8, 28, 175, 10

        DEFPUSHBUTTON "OK",     DID_OK,     192, 90, 52, 14
        PUSHBUTTON    "Cancel", DID_CANCEL, 192, 72, 52, 14
    END
END

DLGTEMPLATE IDD_LONGLINES
BEGIN
    DIALOG "Long Lines", IDD_LONGLINES, 20, 20, 252, 84, , FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        LTEXT      "Limit for long lines:", -1,        8, 64, 84, 8
        ENTRYFIELD "", IDC_LONGLIMIT,                 96, 62, 36, 10, ES_MARGIN | ES_AUTOSCROLL

        AUTORADIOBUTTON "Show ~edge line.",            IDC_LONGEDGELINE, 8, 44, 160, 10, WS_GROUP | WS_TABSTOP
        AUTORADIOBUTTON "Change ~background color.",   IDC_LONGEDGEBACK, 8, 30, 160, 10

        DEFPUSHBUTTON "OK",     DID_OK,     192, 62, 52, 14
        PUSHBUTTON    "Cancel", DID_CANCEL, 192, 44, 52, 14
    END
END

DLGTEMPLATE IDD_WORDWRAP
BEGIN
    DIALOG "Word Wrap Settings", IDD_WORDWRAP, 20, 20, 330, 152, , FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        /* The four rectangles deliberately overlap: only the entry field at the
           top of each is painted while the list is closed, and each combo's top
           edge sits below the previous combo's entry field. */
        CONTROL "", IDC_WWINDENT, 8, 102, 250, 36, WC_COMBOBOX,
                CBS_DROPDOWNLIST | WS_VISIBLE | WS_TABSTOP | WS_GROUP
        CONTROL "", IDC_WWBEFORE, 8,  76, 250, 36, WC_COMBOBOX,
                CBS_DROPDOWNLIST | WS_VISIBLE | WS_TABSTOP
        CONTROL "", IDC_WWAFTER,  8,  50, 250, 36, WC_COMBOBOX,
                CBS_DROPDOWNLIST | WS_VISIBLE | WS_TABSTOP
        CONTROL "", IDC_WWMODE,   8,  24, 250, 36, WC_COMBOBOX,
                CBS_DROPDOWNLIST | WS_VISIBLE | WS_TABSTOP

        DEFPUSHBUTTON "OK",     DID_OK,     266, 124, 54, 14
        PUSHBUTTON    "Cancel", DID_CANCEL, 266, 106, 54, 14
    END
END

DLGTEMPLATE IDD_MODIFYLINES
BEGIN
    DIALOG "Modify Lines", IDD_MODIFYLINES, 20, 20, 300, 118, , FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        LTEXT      "Prefix text to lines:", -1,   8, 98, 120, 8
        ENTRYFIELD "", IDC_STR1,                  8, 82, 220, 10, ES_MARGIN | ES_AUTOSCROLL
        LTEXT      "Append text to lines:", -1,   8, 64, 120, 8
        ENTRYFIELD "", IDC_STR2,                  8, 48, 220, 10, ES_MARGIN | ES_AUTOSCROLL

        LTEXT "$(L)  $(0L)   Document line number.",              -1, 8, 30, 280, 8
        LTEXT "$(N)  $(0N)   Continuous number.",                 -1, 8, 19, 280, 8
        LTEXT "$(I)  $(0I)   Continuous number (zero-based).",    -1, 8,  8, 280, 8

        DEFPUSHBUTTON "OK",     DID_OK,     238, 96, 54, 14
        PUSHBUTTON    "Cancel", DID_CANCEL, 238, 78, 54, 14
    END
END

